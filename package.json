{
  "name": "vm-downloader",
  "version": "1.0.0",
  "description": "VM — تطبيق تحميل الفيديوهات والأغاني بجودة عالية",
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder",
    "build:win": "electron-builder --win",
    "setup": "node scripts/setup.js",
    "brand": "node scripts/brand-setup.js",
    "launcher": "node scripts/create-vm-exe.js",
    "package:portable": "node scripts/package-portable.js",
    "postinstall": "node scripts/setup.js && node scripts/brand-setup.js"
  },
  "author": "VM",
  "license": "MIT",
  "devDependencies": {
    "electron": "^28.0.0",
    "electron-builder": "^24.9.1"
  },
  "dependencies": {
    "ffmpeg-static": "^5.2.0"
  },
  "build": {
    "appId": "com.vm.downloader",
    "productName": "VM",
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/**/*",
      "assets/**/*",
      "node_modules/**/*"
    ],
    "win": {
      "target": "nsis",
      "icon": "assets/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "installerIcon": "assets/icon.ico",
      "uninstallerIcon": "assets/icon.ico"
    }
  }
}
